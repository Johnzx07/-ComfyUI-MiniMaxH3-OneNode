{
  "M:unet": {
    "class_type": "UNETLoader",
    "inputs": { "unet_name": "minimax_h3_fl2va_pruned_fp8_scaled.safetensors", "weight_dtype": "default" },
    "_meta": { "title": "Load Diffusion Model (MiniMax H3 · fl2va)" }
  },
  "M:clip": {
    "class_type": "CLIPLoader",
    "inputs": { "clip_name": "qwen3vl_32b_minimax_h3_int8_convrot.safetensors", "type": "minimax", "device": "default" },
    "_meta": { "title": "Load CLIP (Qwen3-VL · minimax)" }
  },
  "M:vae": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_video_vae_fp16.safetensors" },
    "_meta": { "title": "Load VAE (video)" }
  },
  "M:avae": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" },
    "_meta": { "title": "Load VAE (audio)" }
  },
  "M:cond": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": ["M:clip", 0],
      "vae": ["M:vae", 0],
      "prompt": "",
      "width": 864,
      "height": 480,
      "length": 124
    },
    "_meta": { "title": "MiniMax H3 Image to Video" }
  },
  "M:noise": {
    "class_type": "RandomNoise",
    "inputs": { "noise_seed": 0 },
    "_meta": { "title": "Random Noise" }
  },
  "M:sampsel": {
    "class_type": "KSamplerSelect",
    "inputs": { "sampler_name": "res_multistep" },
    "_meta": { "title": "KSampler Select" }
  },
  "M:sched": {
    "class_type": "BasicScheduler",
    "inputs": { "model": ["M:unet", 0], "scheduler": "simple", "steps": 20, "denoise": 1.0 },
    "_meta": { "title": "Basic Scheduler" }
  },
  "M:guider": {
    "class_type": "BasicGuider",
    "inputs": { "model": ["M:unet", 0], "conditioning": ["M:cond", 0] },
    "_meta": { "title": "Basic Guider (positive-only)" }
  },
  "M:samp": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": ["M:noise", 0],
      "guider": ["M:guider", 0],
      "sampler": ["M:sampsel", 0],
      "sigmas": ["M:sched", 0],
      "latent_image": ["M:cond", 1]
    },
    "_meta": { "title": "Sampler Custom Advanced" }
  },
  "M:vdec": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["M:samp", 0], "vae": ["M:vae", 0] },
    "_meta": { "title": "VAE Decode (video)" }
  },
  "M:adec": {
    "class_type": "VAEDecodeAudio",
    "inputs": { "samples": ["M:samp", 0], "vae": ["M:avae", 0] },
    "_meta": { "title": "VAE Decode Audio" }
  },
  "M:cvid": {
    "class_type": "CreateVideo",
    "inputs": { "images": ["M:vdec", 0], "audio": ["M:adec", 0], "fps": 24, "bit_depth": 8 },
    "_meta": { "title": "Create Video (mux audio)" }
  },
  "M:save": {
    "class_type": "SaveVideo",
    "inputs": { "video": ["M:cvid", 0], "filename_prefix": "ComfyUI-MiniMaxH3-OneNode/MiniMax_H3", "format": "auto", "codec": "auto" },
    "_meta": { "title": "Save Video" }
  }
}
